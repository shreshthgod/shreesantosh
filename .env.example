# Copy to .env.local for local development, and set the same values in
# Vercel → Settings → Environment Variables for production.

# Production origin, no trailing slash. Without it the canonical URL, the Open Graph
# image URL and the sitemap host are all missing.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend (https://resend.com) — the email delivery path for enquiries.
# Without these the form still works: it falls back to the WhatsApp hand-off and
# a copy-details panel, and no lead is silently dropped.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be a sender on a domain verified in Resend. Defaults to onboarding@resend.dev,
# which only delivers to the address that owns the Resend account.
ENQUIRY_FROM_EMAIL=
